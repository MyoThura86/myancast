<?xml version="1.0" encoding="utf-8"?>
<!--
  MyanCast app icon — မြန်မာ အက္ခရာ "မ" (Myanmar / MyanCast ရဲ့ ပထမ စာလုံး) ကို
  ရွှေရောင် stroke တစ်ချက်တည်းနဲ့ ရေးပြီး ခွက်ထဲမှာ ▶ (နားထောင်ရန်) ထည့်ထားတယ်။
  Content က adaptive icon ရဲ့ safe zone (စက်ဝိုင်း r=33) ထဲမှာပဲ ရှိတယ်။
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- "မ" — ဘယ်ဘက် အပေါ်က ကွင်းလေး -->
    <path
        android:pathData="M36,40 a6.5,6.5 0 1,1 13,0 a6.5,6.5 0 1,1 -13,0"
        android:strokeColor="#F0A93B"
        android:strokeWidth="6.5" />

    <!-- "မ" — ဘယ်လက်တံ → ခွက် → ညာလက်တံ -->
    <path
        android:pathData="M36,40 L36,56 C36,65.94 44.06,74 54,74 C63.94,74 72,65.94 72,56 L72,36"
        android:strokeColor="#F0A93B"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- ▶ — ထောင့်ဝိုင်း (fill + stroke round join) -->
    <path
        android:pathData="M50.5,54 L50.5,66 L61.5,60 Z"
        android:fillColor="#F7F3EA"
        android:strokeColor="#F7F3EA"
        android:strokeWidth="3"
        android:strokeLineJoin="round" />
</vector>
